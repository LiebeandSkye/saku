<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E1E1E"
    android:padding="8dp">

    <!-- FRONT / QUESTION STATE -->
    <LinearLayout
        android:id="@+id/layout_front"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="visible">

        <!-- Top Status: Review Counts (15, 17, 21) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tv_front_count_new"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15"
                android:textColor="#5C8AFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_front_count_learn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="17"
                android:textColor="#E06C75"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_front_count_review"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="21"
                android:textColor="#98C379"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Big Kanji -->
        <TextView
            android:id="@+id/tv_front_kanji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="九"
            android:textColor="@android:color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:layout_marginTop="2dp" />

        <!-- Example Sentence Prompt -->
        <TextView
            android:id="@+id/tv_front_sentence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="野球は九人で1チームです。"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Show Answer Button -->
        <TextView
            android:id="@+id/btn_front_show_answer"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Show answer"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_ease" />
    </LinearLayout>

    <!-- BACK / ANSWER REVEALED STATE -->
    <LinearLayout
        android:id="@+id/layout_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone">

        <!-- Top Status: Review Counts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/tv_back_count_new"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15"
                android:textColor="#5C8AFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_back_count_learn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="17"
                android:textColor="#E06C75"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_back_count_review"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="21"
                android:textColor="#98C379"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Furigana above Kanji -->
        <TextView
            android:id="@+id/tv_back_furigana"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="きゅう"
            android:textColor="#CCCCCC"
            android:textSize="12sp" />

        <!-- Big Kanji -->
        <TextView
            android:id="@+id/tv_back_kanji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="九"
            android:textColor="@android:color/white"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

        <!-- Meaning -->
        <TextView
            android:id="@+id/tv_back_meaning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="nine"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Rendered Furigana Sentence Canvas (Pixel-perfect aligned) -->
        <ImageView
            android:id="@+id/iv_back_sentence_canvas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:adjustViewBounds="true"
            android:visibility="gone" />

        <!-- Furigana Line for Sentence (Fallback) -->
        <TextView
            android:id="@+id/tv_back_example_furigana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="や きゅう   きゅうにん   ひと"
            android:textColor="#6CA0DC"
            android:textSize="10sp"
            android:layout_marginTop="4dp"
            android:maxLines="1" />

        <!-- Sentence Line -->
        <TextView
            android:id="@+id/tv_back_example_sentence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="野球は九人で1チームです。"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Sentence English Translation -->
        <TextView
            android:id="@+id/tv_back_example_trans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="In baseball there are nine people on one team."
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 3 Action Buttons: Again, Hard, Open Anki -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/btn_back_again"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:text="Again"
                android:textColor="#FF6B6B"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_ease" />

            <TextView
                android:id="@+id/btn_back_hard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:text="Hard"
                android:textColor="#FFA94D"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_ease" />

            <TextView
                android:id="@+id/btn_back_open_anki"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:gravity="center"
                android:text="Open Anki"
                android:textColor="#74C0FC"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_ease" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>

